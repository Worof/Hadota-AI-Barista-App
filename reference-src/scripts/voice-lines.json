{
 "lang": "ar-EG",
 "items": [
  {
   "id": "def33742",
   "text": "أيوة جاااي"
  },
  {
   "id": "1e7db9f1",
   "text": "ثواني وتبقى جاهزة..."
  },
  {
   "id": "0a8bb381",
   "text": "إيه ده؟ ده كوباية المية! ثواني وراجعلك."
  },
  {
   "id": "f03b5f40",
   "text": "أوبا! حبّة بن وقعت. معلش، عندنا غيرها."
  },
  {
   "id": "13588645",
   "text": "صحة وهنا!"
  },
  {
   "id": "b95c78d2",
   "text": "تتشرب بالهنا!"
  },
  {
   "id": "67e2f738",
   "text": "ده أول موسم لينا مع بعض، يلا نبدأ بقهوة تفتح النفس!"
  },
  {
   "id": "488bc492",
   "text": "كل سنة وانتم طيبين! قهوة تليق بلمّة العيلة."
  },
  {
   "id": "41e9a187",
   "text": "رمضان على الأبواب! نظبطلك قهوة الفطار من دلوقتي."
  },
  {
   "id": "092a9414",
   "text": "رمضان كريم! جاهزلك قهوة بعد الفطار."
  },
  {
   "id": "2d8e626c",
   "text": "عيد سعيد! قهوة العيد عليا."
  },
  {
   "id": "e16cefcc",
   "text": "عيد الأم قرّب، نظبطلها أحلى فنجان."
  },
  {
   "id": "6f1d2190",
   "text": "أهلاً يا "
  },
  {
   "id": "90e907a9",
   "text": "! أنا حدوتة. هسألك كام سؤال صغير وأظبطلك قهوتك من عيوني."
  },
  {
   "id": "d3be27b5",
   "text": "نورتنا تاني يا "
  },
  {
   "id": "d31800be",
   "text": "!"
  },
  {
   "id": "0c55287e",
   "text": "نكرر آخر خلطة ولا نجرب حاجة جديدة يا "
  },
  {
   "id": "fd1b68dc",
   "text": "؟"
  },
  {
   "id": "47ed7d0d",
   "text": "قهوتك جاهزة يا "
  },
  {
   "id": "9f50e354",
   "text": "يا "
  },
  {
   "id": "8f487dd0",
   "text": "، تحبها سخنة ولا ساقعة؟"
  },
  {
   "id": "dab97365",
   "text": "، إيه المشروب اللي نفسك فيه؟"
  },
  {
   "id": "64163019",
   "text": "، هتعملها بإيه في البيت؟"
  },
  {
   "id": "c68d721c",
   "text": "، تحبها خفيفة ولا تقيلة؟"
  },
  {
   "id": "65f3a6af",
   "text": "، الحموضة تحبها قد إيه؟ يعني الطعم المنعش الفاكهي"
  },
  {
   "id": "37009d1b",
   "text": "، والقوام؟ يعني إحساسها في بقك"
  },
  {
   "id": "b223a4e4",
   "text": "، عايز ريحتها تفكرك بإيه؟ اختار لحد ٣"
  },
  {
   "id": "02c7d182",
   "text": "، إيه الطعم اللي نفسك تحسه؟ اختار لحد ٤"
  },
  {
   "id": "61aaaf14",
   "text": "، بتحب لبنك إيه؟"
  },
  {
   "id": "c9367a0f",
   "text": "، السكر عندك؟"
  },
  {
   "id": "64c50e65",
   "text": "، بتحليها بإيه؟"
  },
  {
   "id": "19a4b0a0",
   "text": "، عايز تضيف حاجة؟ اختار اللي يعجبك"
  },
  {
   "id": "870e32e2",
   "text": "، تحميص البن؟"
  },
  {
   "id": "942ce3a2",
   "text": "، الكافيين؟"
  },
  {
   "id": "5ad9f0c2",
   "text": "، البن يجي منين؟"
  },
  {
   "id": "0052173f",
   "text": "، أنهي نوع؟"
  },
  {
   "id": "4252c637",
   "text": "طيب يا "
  },
  {
   "id": "49441d49",
   "text": "قولّي يا "
