{
 "lang": "ar-EG",
 "items": [
  {
   "id": "fdf06a3558",
   "text": "أيوة جاااي"
  },
  {
   "id": "05fbeb44bf",
   "text": "أهلاً!"
  },
  {
   "id": "bb2e207aaf",
   "text": "أنا حدوتة."
  },
  {
   "id": "3ddb58c58c",
   "text": "هسألك كام سؤال وأظبطلك قهوتك."
  },
  {
   "id": "90a7c6af16",
   "text": "نورتنا تاني!"
  },
  {
   "id": "ad81b6ab87",
   "text": "قهوتك جاهزة!"
  },
  {
   "id": "4a20c6e56b",
   "text": "صحة وهنا!"
  },
  {
   "id": "7ab5ea757a",
   "text": "تتشرب بالهنا!"
  },
  {
   "id": "91a994b267",
   "text": "تحبها سخنة ولا ساقعة؟"
  },
  {
   "id": "4773e47b5e",
   "text": "طيب، تحبها سخنة ولا ساقعة؟"
  },
  {
   "id": "2c849e9694",
   "text": "قولّي، تحبها سخنة ولا ساقعة؟"
  },
  {
   "id": "cdccdd2621",
   "text": "إيه المشروب اللي نفسك فيه؟"
  },
  {
   "id": "3d35c067ef",
   "text": "طيب، إيه المشروب اللي نفسك فيه؟"
  },
  {
   "id": "15170be397",
   "text": "قولّي، إيه المشروب اللي نفسك فيه؟"
  },
  {
   "id": "d48a17e88c",
   "text": "هتعملها بإيه في البيت؟"
  },
  {
   "id": "00c5534d16",
   "text": "طيب، هتعملها بإيه في البيت؟"
  },
  {
   "id": "48c31a0803",
   "text": "قولّي، هتعملها بإيه في البيت؟"
  },
  {
   "id": "3e558f1aa4",
   "text": "تحبها خفيفة ولا تقيلة؟"
  },
  {
   "id": "2174edad30",
   "text": "طيب، تحبها خفيفة ولا تقيلة؟"
  },
  {
   "id": "69504b9f7e",
   "text": "قولّي، تحبها خفيفة ولا تقيلة؟"
  },
  {
   "id": "5d8525222b",
   "text": "الحموضة تحبها قد إيه؟"
  },
  {
   "id": "2e3012ea5a",
   "text": "يعني الطعم المنعش الفاكهي"
  },
  {
   "id": "6e0ec9647b",
   "text": "طيب، الحموضة تحبها قد إيه؟"
  },
  {
   "id": "10ed04263b",
   "text": "قولّي، الحموضة تحبها قد إيه؟"
  },
  {
   "id": "3d98454209",
   "text": "والقوام؟"
  },
  {
   "id": "d6099c9e33",
   "text": "يعني إحساسها في بقك"
  },
  {
   "id": "69de4c2077",
   "text": "طيب، والقوام؟"
  },
  {
   "id": "5be0eb119d",
   "text": "قولّي، والقوام؟"
  },
  {
   "id": "c67cebe6bf",
   "text": "عايز ريحتها تفكرك بإيه؟"
  },
  {
   "id": "e985169d2a",
   "text": "اختار لحد ٣"
  },
  {
   "id": "9a99dfccbb",
   "text": "طيب، عايز ريحتها تفكرك بإيه؟"
  },
  {
   "id": "639a1e83dd",
   "text": "قولّي، عايز ريحتها تفكرك بإيه؟"
  },
  {
   "id": "48c4ce18bc",
   "text": "إيه الطعم اللي نفسك تحسه؟"
  },
  {
   "id": "38dac264d1",
   "text": "اختار لحد ٤"
  },
  {
   "id": "f27db6c2bb",
   "text": "طيب، إيه الطعم اللي نفسك تحسه؟"
  },
  {
   "id": "07e62d22bb",
   "text": "قولّي، إيه الطعم اللي نفسك تحسه؟"
  },
  {
   "id": "ceddf9bfdd",
   "text": "بتحب لبنك إيه؟"
  },
  {
   "id": "e28c15a9c5",
   "text": "طيب، بتحب لبنك إيه؟"
  },
  {
   "id": "9551033090",
   "text": "قولّي، بتحب لبنك إيه؟"
  },
  {
   "id": "23416fbe02",
   "text": "السكر عندك؟"
  },
  {
   "id": "95007f7622",
   "text": "طيب، السكر عندك؟"
  },
  {
   "id": "0311deb999",
   "text": "قولّي، السكر عندك؟"
  },
  {
   "id": "bd74cfd942",
   "text": "بتحليها بإيه؟"
  },
  {
   "id": "69db1905dd",
   "text": "طيب، بتحليها بإيه؟"
  },
  {
   "id": "f6332c7f50",
   "text": "قولّي، بتحليها بإيه؟"
  },
  {
   "id": "6ecd598c1f",
   "text": "عايز تضيف حاجة؟"
  },
  {
   "id": "c68e692fb4",
   "text": "اختار اللي يعجبك"
  },
  {
   "id": "ed0b72ad4b",
   "text": "طيب، عايز تضيف حاجة؟"
  },
  {
   "id": "8fdf8e39da",
   "text": "قولّي، عايز تضيف حاجة؟"
  },
  {
   "id": "ba3881d5f7",
   "text": "تحميص البن؟"
  },
  {
   "id": "cd13962970",
   "text": "طيب، تحميص البن؟"
  },
  {
   "id": "b0dd933189",
   "text": "قولّي، تحميص البن؟"
  },
  {
   "id": "1730145b0c",
   "text": "الكافيين؟"
  },
  {
   "id": "ed97cb81d5",
   "text": "طيب، الكافيين؟"
  },
  {
   "id": "ea717b438f",
   "text": "قولّي، الكافيين؟"
  },
  {
   "id": "0320ca6ed4",
   "text": "البن يجي منين؟"
  },
  {
   "id": "7cd67cd873",
   "text": "طيب، البن يجي منين؟"
  },
  {
   "id": "5d399c928c",
   "text": "قولّي، البن يجي منين؟"
  },
  {
   "id": "1fd0ba3c68",
   "text": "أنهي نوع؟"
  },
  {
   "id": "1676356c7d",
   "text": "طيب، أنهي نوع؟"
  },
  {
   "id": "029c6d5de0",
   "text": "قولّي، أنهي نوع؟"
  }
 ]
}