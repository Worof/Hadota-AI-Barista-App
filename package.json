{
  "name": "hadota",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hadota - Egyptian Arabic AI barista (static PWA + Supabase)",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node --test tests/engine.test.mjs tests/learning.test.mjs tests/nlu.test.mjs tests/supabase-adapter.test.mjs",
    "test:engine": "node --test tests/engine.test.mjs",
    "test:learning": "node --test tests/learning.test.mjs",
    "sim": "node tests/evaluate.mjs 200 30",
    "e2e": "python3 tests/e2e.py",
    "analytics": "python3 -m analytics.report --demo",
    "test:py": "python3 -m unittest discover -s analytics/tests -t .",
    "test:all": "npm test && npm run test:py && npm run e2e && npm run test:features && npm run test:voice",
    "demo-events": "node scripts/export_demo_events.mjs 300 18 analytics/demo_events.jsonl",
    "test:voice": "python3 tests/voice.py",
    "voice:lines": "node scripts/voice-lines.mjs",
    "test:features": "python3 tests/features.py"
  },
  "devDependencies": {
    "eslint": "^10.14.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}